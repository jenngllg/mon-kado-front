{
  "name": "mon-kado-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "api:types": "node tools/openapi-types/generate-api-types.js",
    "api:types:check": "node tools/openapi-types/generate-api-types.js --check",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p jsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "happy-dom": "20.14.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0"
  }
}

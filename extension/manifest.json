{
  "manifest_version": 3,
  "name": "MonKado — ajouter un souhait",
  "version": "1.0.0",
  "description": "Ajoute une page produit à une liste MonKado.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.monkado.fr/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@monkado.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["browsingActivity", "websiteContent"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "icons": { "128": "icon.png" },
  "content_scripts": [{ "matches": ["https://www.monkado.fr/*"], "js": ["session-bridge.js"] }],
  "action": {
    "default_icon": "icon.png",
    "default_title": "Ajouter à MonKado",
    "default_popup": "popup.html"
  }
}
